# ---------------------------------------------------------------------------
# PARTICIPANT DATA — NEVER COMMIT
# ---------------------------------------------------------------------------
# A private GitHub remote is still a copy on someone else's server, and git
# history outlives deletion. Nothing that could identify a participant, and no
# collected data, may ever enter this repository.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.wav
*.m4a
*.jsonl
/data/
/export/
/mirror/
**/participant_data/
allocation*.csv          # the sealed randomisation list
pin_hash*
*.local.json

# ---------------------------------------------------------------------------
# Node / JavaScript
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
*.tsbuildinfo
coverage/
.eslintcache

# Metro
.metro-health-check*
/app/.metro/

# Vitest / Jest
/packages/*/coverage/

